{
  "openapi": "3.0.0",
  "info": {
    "title": "Customer Enrollment Dashboard API",
    "description": "API for managing customer records and automating agreements for services.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/",
      "description": "Development server"
    }
  ],
  "paths": {    
    "/customer/health-check": {      
      "get": {
        "tags":["Customer"],
        "summary": "Health Check ",
        "description": "",       
        "responses": {
          "200": {
            "description": "Up and running"
          }
        }
      }
    },
    "/customer/create": {      
      "post": {
        "tags":["Customer"],
        "summary": "Create a record for a customer",
        "description": "Create a record for a customer ",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SingleRoute"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Report created successfully."
          }
        }
      }
    },
    "/single-route/test": {      
      "post": {
        "tags":["Single Route"],
        "summary": "Sample PDF ",
        "description": "",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SampleAgreement"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Report created successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {      
      "SingleRoute": {
        "type": "object",
        "properties": {
          "start": {
            "type": "object",
            "properties":{
                "lat": {"type":"number"},
                "lon": {"type":"number"}
            }
          },
          "end": {
            "properties":{
                "lat": {"type":"number"},
                "lon": {"type":"number"}
            }
          }
        },
        "required": ["name"]
      },
      "SampleAgreement": {
        "type": "object",
        "properties": {
          "recipientList": {
            "type": "array",
            "items":{
              "type":"object",
              "properties":{
                "email": {"type":"string"},
              "name": {"type":"string"}
              }                
            }
          },
          "customerName": {
            "type":"string"            
          }
        },
        "required": ["name"]
      }
    }
  }
}